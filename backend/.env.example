# Copy to .env and fill in. API keys stay on the backend only.

# --- AI provider (the model is intentionally not defaulted: choose one) ---
# Providers: openai | xai | custom (any OpenAI-compatible endpoint; set AI_BASE_URL)
AI_PROVIDER=
AI_MODEL=

# Provider-specific keys (or use the generic AI_API_KEY for any provider)
OPENAI_API_KEY=
XAI_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=https://example.com/v1

# Optional AI tuning (leave unset to use the provider defaults)
# AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=1500
AI_TIMEOUT_SECONDS=60

# --- Data ---
# Defaults to backend/data/experiments
# DATA_DIR=/absolute/path/to/nasa/csv/files

# Largest CSV accepted by POST /api/investigations (bytes)
# MAX_UPLOAD_BYTES=5242880

# --- Retrieval limits ---
# MAX_CONTEXT_CHARS=12000
# MAX_INVESTIGATIONS_PER_QUERY=3
# MAX_ROWS_PER_INVESTIGATION=15

# --- Ranking weights in percent (normalised if they do not sum to 100) ---
# RANKING_WEIGHTS={"mission_relevance":30,"fire_safety_relevance":25,"data_quality":20,"environmental_similarity":15,"predictive_modeling_value":10}

# --- Server ---
# Comma-separated origins, or * for all
CORS_ORIGINS=*
PORT=5000
FLASK_DEBUG=0

# Optional semantic index (build with python build_index.py after preprocessing)
EMBEDDING_MODEL=text-embedding-3-small
# RAG_INDEX_PATH=/private/path/index.sqlite
# For multi-investigation exploration, allow up to five and a larger context:
# MAX_CONTEXT_CHARS=32000
# MAX_INVESTIGATIONS_PER_QUERY=5

# Brief responses and lower model latency (OpenAI reasoning models only)
# AI_REASONING_EFFORT=low
# AI_MAX_TOKENS=2500
# MAX_CONTEXT_CHARS=16000
# MAX_ROWS_PER_INVESTIGATION=6
# MAX_CHUNKS_PER_INVESTIGATION=3
# EMBEDDING_TIMEOUT_SECONDS=5
